# VolumPOS Licensing Hub — environment reference.
#
# Two different things live in this file's world, and they have different rules:
#
#  1. EDGE FUNCTION SECRETS (below, under "Edge Function secrets").
#     Set with `supabase secrets set ...`. They live in Supabase only and must
#     never be committed. This section is documentation, not what `.env` is for.
#
#  2. ADMIN PANEL CONFIG (HUB_URL / ADMIN_ORIGIN).
#     Copied into `.env` and used by `npm run config` to generate `config.js`.
#     Everything here is served to a browser, so it must contain NO secrets.

# ─────────────────────────────────────────────────────────── Panel config ──
# Copied to `.env` for `npm run config` → `config.js` (browser-loadable).

# Hub Edge Functions base URL (no trailing slash).
HUB_URL=https://pmtoxxxxxx.supabase.co/functions/v1

# ──────────────────────────────────────────────────── Edge Function secrets ──
# Set with: supabase secrets set KEY=value
# Never place these in `.env` or `config.js`.

# The family signing key (PKCS#8 DER, base64). MUST match the public key baked
# into the products. Do NOT commit. Back it up offline.
LICENSE_PRIVATE_KEY=

# Long random string required by /verify and /admin (x-admin-secret header).
LICENSE_ADMIN_SECRET=

# Optional: narrows hub CORS to the admin panel's origin (comma-separated).
# Unset = allow any origin (fine for local development).
ADMIN_ALLOWED_ORIGIN=

# Optional: the public key compared against in scripts/verify-keypair.ts.
EXPECTED_PUBLIC_KEY=MCowBQYDK2VwAyEA1a/zG/WDA9gVk5e9vjCVx6sFk9TpbuPcIb/BtS5nwkM=
