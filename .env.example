# VolumPOS Licensing Hub — secret reference.
#
# These are Edge Function secrets, set with:
#   supabase secrets set LICENSE_PRIVATE_KEY=... LICENSE_ADMIN_SECRET=...
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Supabase runtime; never set them yourself and never commit real values.

# The family signing key (PKCS#8 DER, base64). MUST match the public key baked
# into the products. Do NOT put this in a repo. Back it up offline.
LICENSE_PRIVATE_KEY=

# Long random string required by /verify and /admin (x-admin-secret header).
LICENSE_ADMIN_SECRET=1234567887654321

# Optional: the public key to compare against in scripts/verify-keypair.ts.
EXPECTED_PUBLIC_KEY=MCowBQYDK2VwAyEA1a/zG/WDA9gVk5e9vjCVx6sFk9TpbuPcIb/BtS5nwkM=
